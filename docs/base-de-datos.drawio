t_seen_at_k" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=10;fontColor=#7a4f9e;overflow=hidden;whiteSpace=wrap;html=1;" vertex="1" parent="t_notification_seen_last_seen_at"><mxGeometry width="60" height="26" as="geometry"><mxRectangle width="60" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="t_notification_seen_last_seen_at_n" value="last_seen_at" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;html=1;" vertex="1" parent="t_notification_seen_last_seen_at"><mxGeometry x="60" width="180" height="26" as="geometry"><mxRectangle width="180" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="t_notification_seen_last_seen_at_t" value="timestamptz · NOT NULL" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=4;fontSize=10;fontColor=#666666;overflow=hidden;whiteSpace=wrap;html=1;" vertex="1" parent="t_notification_seen_last_seen_at"><mxGeometry x="240" width="140" height="26" as="geometry"><mxRectangle width="140" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;Reglas garantizadas por la base de datos&lt;/b&gt;&lt;br&gt;• &lt;b&gt;RN-01&lt;/b&gt; un solo módulo activo: índice único parcial &lt;i&gt;modules(is_active) WHERE is_active&lt;/i&gt;&lt;br&gt;• un solo módulo programado: &lt;i&gt;modules(status) WHERE status = &#x27;SCHEDULED&#x27;&lt;/i&gt;&lt;br&gt;• &lt;b&gt;RN-02&lt;/b&gt; registro único por módulo: &lt;i&gt;students(module_id, registration_number)&lt;/i&gt;&lt;br&gt;• correo único por módulo: &lt;i&gt;students(module_id, lower(email))&lt;/i&gt;&lt;br&gt;• una fecha de clase por día: &lt;i&gt;class_sessions(module_id, class_date)&lt;/i&gt;&lt;br&gt;• &lt;b&gt;RN-03&lt;/b&gt; una marca por estudiante y clase: &lt;i&gt;attendances(student_id, session_id)&lt;/i&gt;&lt;br&gt;• una justificación pendiente por clase: &lt;i&gt;justifications(student_id, session_id) WHERE status = &#x27;PENDING&#x27;&lt;/i&gt;&lt;br&gt;• &lt;b&gt;RN-05&lt;/b&gt; las faltas sin marca no se guardan: se calculan al consultar&lt;br&gt;• &lt;b&gt;RN-08&lt;/b&gt; nada se borra al cambiar de módulo: cada fila queda asociada a su &lt;i&gt;module_id&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Leyenda&lt;/b&gt;: PK clave primaria · FK clave foránea · UQ único · ⊣ uno obligatorio · ○&amp;lt; cero o muchos · |&amp;lt; uno o muchos&lt;br&gt;Colores: morado núcleo · verde asistencia · naranja justificaciones · amarillo cambios de clase · gris historial y notificaciones" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1800" y="760" width="560" height="330" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeColor=#888888;" edge="1" parent="1" source="t_activity_logs_module_id" target="t_modules_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeColor=#888888;" edge="1" parent="1" source="t_activity_logs_student_id" target="t_students_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERoneToMany;endFill=0;startFill=0;strokeColor=#888888;" edge="1" parent="1" source="t_attendance_changes_admin_id" target="t_admins_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERoneToMany;endFill=0;startFill=0;strokeColor=#888888;" edge="1" parent="1" source="t_attendance_changes_attendance_id" target="t_attendances_